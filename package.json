{
  "name": "belluzzi-open-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first open source tools by Belluzzi.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "next": "16.3.1",
    "next-intl": "^4.13.2",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
